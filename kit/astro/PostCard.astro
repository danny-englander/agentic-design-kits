---
// One post pointed to from inside another (PostCard in COMPONENTS.md): a 2px rule, a small label,
// the linked title, its summary and a quiet line with the date and meta, and the post's cover as a
// small square beside it from 640px, if it has one. The title is the card's one link. The kit
// reads no collection: the site looks the post up (see PostCard) and passes it in as a `Post`.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Post } from './types';

interface Props {
  post: Post;
  /** The post's cover, shown as a small square. Its alt is empty: the title says where it goes. */
  image?: ImageMetadata;
  /** The small label over the title. */
  label?: string;
  /** Utilities for spacing, e.g. "mt-16". */
  class?: string;
}
const { post, image, label = 'Related post', class: className } = Astro.props;

// Dates are plain days, so format them in UTC or they can slip back a day.
const date = new Date(post.date).toLocaleDateString('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
  timeZone: 'UTC',
});
---

<div class:list={['post-card', image && 'post-card--image', className]}>
  <div>
    <p class="post-card-label label muted">{label}</p>
    <p class="post-card-title"><a href={post.href}>{post.title}<span aria-hidden="true">&nbsp;→</span></a></p>
    {post.summary && <p class="post-card-summary">{post.summary}</p>}
    <p class="post-card-meta"><time datetime={post.date}>{date}</time>{post.meta && ` · ${post.meta}`}</p>
  </div>
  {image && <Image class="media media--1x1" src={image} alt="" widths={[160, 320]} sizes="8rem" loading="lazy" />}
</div>

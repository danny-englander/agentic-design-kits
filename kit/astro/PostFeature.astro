---
// One post at the top of a blog's index (PostFeature in COMPONENTS.md), where a Hero would go,
// before the PostList of the other posts. Two layouts, picked by the image's shape unless
// `layout` says otherwise: a square or portrait image sits beside the text, 50/50 from 768px and
// cropped square; a landscape image goes under text that runs the full width, cropped 16:9.
// Import the image so Astro knows its size. For something other than a raster image, such as an
// SVG that follows the theme, leave out image and alt and fill the media slot instead.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Post } from './types';

interface Props {
  post: Post;
  image?: ImageMetadata;
  /** One sentence on what the image shows. */
  alt?: string;
  /** The small label over the title. One or two words. */
  label?: string;
  /** The button's text. One or two words. */
  action?: string;
  level?: 'h1' | 'h2';
  /** 'split': text beside a square image. 'wide': full-width text over a 16:9 image. By default,
   * wide for a landscape image and split for any other. */
  layout?: 'split' | 'wide';
}
const { post, image, alt, label = 'Featured', action = 'Read post', level: Title = 'h2' } = Astro.props;
const wide = (Astro.props.layout ?? (image && image.width > image.height ? 'wide' : 'split')) === 'wide';

// Dates are plain days, so format them in UTC or they can slip back a day.
const date = new Date(post.date).toLocaleDateString('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
  timeZone: 'UTC',
});
---

<article class:list={['post-feature', { 'post-feature--wide': wide }]}>
  <div>
    <p class="post-feature-label">{label}</p>
    <Title class="post-feature-title">
      <a href={post.href}>{post.title}</a>
    </Title>
    {post.summary && <p class="lead post-feature-summary">{post.summary}</p>}
    <p class="post-feature-meta">
      <time datetime={post.date}>{date}</time>{post.meta && ` · ${post.meta}`}
    </p>
    <a class="btn" href={post.href} aria-label={`${action}: ${post.title}`}>{action}</a>
  </div>
  <slot name="media">
    {
      image && (
        <Image
          class:list={['media', wide ? 'media--16x9' : 'media--1x1']}
          src={image}
          alt={alt ?? ''}
          widths={[480, 800, 1200, 1600, 2000].filter((w) => w <= image.width)}
          sizes={wide ? '(min-width: 88rem) 88rem, 100vw' : '(min-width: 768px) 50vw, 100vw'}
          loading="eager"
          fetchpriority="high"
        />
      )
    }
  </slot>
</article>

---
// The traditional footer at the end of the page (Footer in COMPONENTS.md). The site name, a
// line about the site and a note on the left; links on the right. Stacks on phones, two
// columns from 768px. Put it in BaseLayout's "footer" slot, so it stays outside <main>.
//
// `links` takes the same MenuItem[] as the menu: every item with an href is listed, nested ones
// included, so the footer never needs its own list. The "note" slot holds a credit or a
// copyright line (links allowed); the default slot adds anything under the links. `related`
// lists a few other sites (a sister site, the project's home) in a column of their own: each
// with that site's own mark in its own colors, if given, and ending with ↗; under the links up to
// 1024px, a third column from there.
import type { MenuItem, RelatedSite } from './types';

interface Props {
  name: string;
  description?: string;
  links?: MenuItem[];
  /** The links' landmark name. Give each footer on a page its own. */
  label?: string;
  /** Links to other sites, in a third column. */
  related?: RelatedSite[];
  /** The related links' landmark name. */
  relatedLabel?: string;
  tone?: 'paper' | 'bar';
  /** Utilities for spacing, e.g. "mt-0". */
  class?: string;
}
const {
  name,
  description,
  links = [],
  label = 'Footer',
  related = [],
  relatedLabel = 'Related sites',
  tone = 'paper',
  class: className,
} = Astro.props;

const flatten = (items: MenuItem[]): MenuItem[] =>
  items.flatMap((item) => [...(item.href ? [item] : []), ...flatten(item.children ?? [])]);
const flat = flatten(links);
---

<footer class:list={['site-footer', tone === 'bar' && 'site-footer--bar', className]}>
  <div class="site-footer-inner">
    <div>
      <p class="site-footer-name">{name}</p>
      {description && <p class="site-footer-text">{description}</p>}
      {Astro.slots.has('note') && <p class="site-footer-note"><slot name="note" /></p>}
    </div>
    {
      (flat.length > 0 || Astro.slots.has('default')) && (
        <nav aria-label={label}>
          {flat.length > 0 && (
            <ul class="site-footer-links">
              {flat.map((item) => (
                <li>
                  <a href={item.href} aria-current={item.current ? 'page' : undefined}>
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          )}
          <slot />
        </nav>
      )
    }
    {
      related.length > 0 && (
        <nav class="site-footer-related" aria-label={relatedLabel}>
          <ul class="site-footer-links">
            {related.map((site) => (
              <li>
                <a
                  href={site.href}
                  style={site.color && `--site-mark: ${site.color.light}; --site-mark-dark: ${site.color.dark}`}
                >
                  {site.mark && (
                    <svg class="site-footer-mark" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                      <path d={site.mark} />
                    </svg>
                  )}
                  {site.label}<span class="ext-arrow" aria-hidden="true">↗</span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
  </div>
</footer>

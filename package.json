{
  "name": "swiss-minimal",
  "version": "0.1.0",
  "private": true,
  "description": "A type-led design kit: plain CSS, a few small scripts and Astro components, for Tailwind v4 sites.",
  "license": "MIT",
  "author": "Danny Englander",
  "homepage": "https://www.swissminimal.ch",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danny-englander/swiss-minimal-design-kit.git"
  },
  "keywords": ["design-kit", "css", "astro", "astro-component", "tailwindcss"],
  "type": "module",
  "workspaces": ["demo", "verdigris", "verdigris/demo"],
  "files": ["kit", "fonts", "DESIGN.md", "COMPONENTS.md", "TOOLING.md", "tokens.json"],
  "scripts": {
    "shared": "node verdigris/scripts/shared.mjs",
    "shared:check": "node verdigris/scripts/shared.mjs --check",
    "pack": "node --experimental-strip-types --no-warnings scripts/pack.ts",
    "release": "node --experimental-strip-types --no-warnings scripts/release.ts"
  },
  "exports": {
    "./tailwind.css": "./kit/tailwind.css",
    "./theme.css": "./kit/theme.css",
    "./fonts.css": "./kit/fonts.css",
    "./types": "./kit/astro/types.ts",
    "./astro/*": "./kit/astro/*",
    "./fonts/*": "./fonts/*",
    "./tokens.json": "./tokens.json",
    "./package.json": "./package.json",
    "./*.js": "./kit/*.js"
  },
  "peerDependencies": {
    "astro": ">=7.0.0",
    "astro-icon": "^1.1.5",
    "tailwindcss": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "astro": { "optional": true },
    "astro-icon": { "optional": true },
    "tailwindcss": { "optional": true }
  }
}

{
  "name": "@agentic-design-kits/verdigris",
  "version": "0.1.0",
  "private": true,
  "description": "A design kit in Cormorant, copper green and engraved line work, for Astro and Tailwind v4 sites. Built on Swiss Minimal.",
  "license": "MIT",
  "author": "Danny Englander",
  "homepage": "https://verdigris.ch",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danny-englander/agentic-design-kits.git",
    "directory": "verdigris"
  },
  "keywords": ["design-kit", "css", "astro", "astro-component", "tailwindcss"],
  "publishConfig": { "access": "public" },
  "type": "module",
  "files": ["kit", "fonts", "DESIGN.md", "COMPONENTS.md", "tokens.json"],
  "scripts": {
    "shared": "node scripts/shared.mjs",
    "shared:check": "node scripts/shared.mjs --check"
  },
  "exports": {
    "./tailwind.css": "./kit/tailwind.css",
    "./verdigris.css": "./kit/verdigris.css",
    "./fonts.css": "./kit/fonts.css",
    "./types": "./kit/types.ts",
    "./astro/BaseLayout.astro": "./kit/astro/BaseLayout.astro",
    "./astro/Mark.astro": "./kit/astro/Mark.astro",
    "./astro/Rosette.astro": "./kit/astro/Rosette.astro",
    "./astro/*.astro": "./kit/shared/astro/*.ts",
    "./fonts/*": "./fonts/*",
    "./tokens.json": "./tokens.json",
    "./package.json": "./package.json",
    "./*.js": "./kit/shared/*.ts"
  },
  "dependencies": {
    "@agentic-design-kits/swiss-minimal": "file:.."
  },
  "peerDependencies": {
    "astro": ">=7.0.0",
    "astro-icon": "^1.1.5",
    "tailwindcss": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "astro": { "optional": true },
    "astro-icon": { "optional": true },
    "tailwindcss": { "optional": true }
  }
}

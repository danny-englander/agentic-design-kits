---
// The type styles and every color token, drawn with the kit's own classes and token utilities,
// so the page shows what a site can use. The values and contrast ratios come from tokens.json.
import SiteLayout from '../layouts/SiteLayout.astro';
import PageTitle from '@agentic-design-kits/verdigris/astro/PageTitle.astro';
import tokens from '../../../tokens.json';
import { groups as otGroups, features, leftOut, type Feature } from '../data/opentype';
import { doc } from '../data/prompts';
import { glyphGroups, codePoint } from '../data/glyphs';

/** Aa Bb … Zz, for the cards that change letters across the alphabet. */
const alphabet = Array.from({ length: 26 }, (_, i) => String.fromCharCode(65 + i) + String.fromCharCode(97 + i)).join(' ');
/** A feature's two states: the font's default, then the card's change. */
const states = (f: Feature) => [
  f.baseline ?? { label: f.onByDefault ? 'On, the default' : 'Off', value: 'normal' },
  { label: f.onByDefault ? 'Off' : f.baseline ? `${f.name}, on` : 'On', value: `"${f.tag}" ${f.onByDefault ? 0 : 1}` },
];
/** Whether the feature applies to the whole sample, or only to its marked parts. */
const partial = (f: Feature) => f.sample.some((p) => p.on);
const prices = [
  ['Coffee', '3.50'],
  ['Bread', '11.20'],
  ['Cheese', '7.85'],
  ['Wine', '18.00'],
  ['Olives', '4.10'],
];

type Theme = 'light' | 'dark';
const values = new Map(tokens.color.tokens.map((t) => [t.name, t.value as Record<Theme, string>]));
/** A token's color in one theme, following references such as "{bar}". */
const hex = (name: string, theme: Theme): string => {
  const v = values.get(name)?.[theme] ?? '';
  return v.startsWith('{') ? hex(v.slice(1, -1), theme) : v;
};
const luminance = (h: string) => {
  const [r, g, b] = [1, 3, 5].map((i) => {
    const c = parseInt(h.slice(i, i + 2), 16) / 255;
    return c <= 0.03928 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4;
  });
  return 0.2126 * r + 0.7152 * g + 0.0722 * b;
};
const ratio = (a: string, b: string, theme: Theme) => {
  const [hi, lo] = [luminance(hex(a, theme)), luminance(hex(b, theme))].sort((x, y) => y - x);
  return `${((hi + 0.05) / (lo + 0.05)).toFixed(1)}:1`;
};

interface Swatch {
  name: string;
  /** The utilities a site writes. Literal, so Tailwind generates them. */
  utilities: string;
  chip: string;
  use: string;
  /** The token this color is read against, for the contrast ratio. */
  against?: string;
}
const groups: { title: string; swatches: Swatch[] }[] = [
  {
    title: 'The page',
    swatches: [
      { name: 'paper', utilities: 'bg-paper', chip: 'bg-paper', use: 'The page background.' },
      { name: 'ink', utilities: 'text-ink, bg-ink', chip: 'bg-ink', use: 'Body text, headings and the scotch rule.', against: 'paper' },
      { name: 'muted', utilities: 'text-muted', chip: 'bg-muted', use: 'Secondary text: meta, captions, notes.', against: 'paper' },
      { name: 'rule', utilities: 'border-rule', chip: 'bg-rule', use: 'Thin dividers. Decorative, never the only edge of a control.', against: 'paper' },
    ],
  },
  {
    title: 'Verdigris',
    swatches: [
      { name: 'accent-text', utilities: 'text-accent-text, bg-accent-text', chip: 'bg-accent-text', use: 'Small verdigris text and links, and the primary button.', against: 'paper' },
      { name: 'accent', utilities: 'text-accent, bg-accent', chip: 'bg-accent', use: 'Large shapes and the focus ring only, never small text.', against: 'paper' },
      { name: 'accent-ink', utilities: 'text-accent-ink', chip: 'bg-accent-ink', use: 'Text on a verdigris fill.', against: 'accent-text' },
      { name: 'accent-bright', utilities: 'text-accent-bright', chip: 'bg-accent-bright', use: 'Verdigris text and marks on a bar.', against: 'bar' },
    ],
  },
  {
    title: 'Copper',
    swatches: [
      { name: 'copper-text', utilities: 'text-copper-text', chip: 'bg-copper-text', use: 'Labels and small ornament. Never marks an action.', against: 'paper' },
      { name: 'copper', utilities: 'text-copper, bg-copper', chip: 'bg-copper', use: 'Large ornament only.', against: 'paper' },
      { name: 'copper-bright', utilities: 'text-copper-bright', chip: 'bg-copper-bright', use: 'Copper on a bar.', against: 'bar' },
    ],
  },
  {
    title: 'Bars',
    swatches: [
      { name: 'bar', utilities: 'bg-bar', chip: 'bg-bar', use: 'Surfaces that stay dark in both themes: the panel, drawer and toast.' },
      { name: 'bar-ink', utilities: 'text-bar-ink', chip: 'bg-bar-ink', use: 'Text on a bar.', against: 'bar' },
    ],
  },
];
---

<SiteLayout title="Type and color" description="Verdigris's type styles and every color token, in light and dark.">
  <PageTitle title="Type and color" />
  <div class="pb-16">
    <p class="lead mb-16 max-w-3xl">
      Every style and color here is drawn with the kit's own classes and token utilities. Switch the theme in the
      top bar and the whole page follows.
    </p>

    <section class="rule-thick mb-20 pt-6" aria-labelledby="type">
      <p class="label text-copper-text">Type</p>
      <h2 class="h2 mb-8" id="type">Cormorant, set larger and heavier</h2>
      <dl class="border-t border-ink">
        <div class="type-row">
          <dt class="label">Display</dt>
          <dd class="display">Verdigris</dd>
          <dd class="small text-muted"><code>.display</code>, 300</dd>
        </div>
        <div class="type-row">
          <dt class="label">Heading</dt>
          <dd class="h2">Order first, then ornament</dd>
          <dd class="small text-muted"><code>.h2</code>, 300</dd>
        </div>
        <div class="type-row">
          <dt class="label">Title</dt>
          <dd class="title">The scotch rule</dd>
          <dd class="small text-muted"><code>.title</code>, 600</dd>
        </div>
        <div class="type-row">
          <dt class="label">Lead</dt>
          <dd class="lead">The discipline of a grid, the warmth of a book.</dd>
          <dd class="small text-muted"><code>.lead</code>, 300 italic</dd>
        </div>
        <div class="type-row">
          <dt class="label">Body</dt>
          <dd>Copper left beside vinegar grows a pale blue-green crust. Garamond forms open up the counters of a and e for reading.</dd>
          <dd class="small text-muted">500, Garamond forms on</dd>
        </div>
        <div class="type-row">
          <dt class="label">Label</dt>
          <dd class="label">Archive · Materials</dd>
          <dd class="small text-muted"><code>.label</code>, 600, sentence case</dd>
        </div>
        <div class="type-row">
          <dt class="label">Small</dt>
          <dd class="small text-muted">The floor: 6 November 2026, 3 items, set at 18px</dd>
          <dd class="small text-muted"><code>.small</code>, 18px at least</dd>
        </div>
      </dl>
      <div class="mt-12 grid gap-8 md:grid-cols-3">
        <div class="border-t border-ink pt-3">
          <h3 class="label mb-2">Figures</h3>
          <p class="text-4xl font-light">1234567890</p>
          <p class="num text-4xl font-light">1234567890</p>
          <p class="small text-muted mt-2">Old-style in text, lining and tabular with <code>.num</code>.</p>
        </div>
        <div class="border-t border-ink pt-3">
          <h3 class="label mb-2">Italic voice</h3>
          <p class="text-4xl font-light italic">Hedera &amp; patina</p>
          <p class="small text-muted mt-2">Leads, captions, the current page and quotations.</p>
        </div>
        <div class="border-t border-ink pt-3">
          <h3 class="label mb-2">Letterforms</h3>
          <p class="text-4xl font-light [font-feature-settings:'hlig','dlig','liga']">fifth, strict, act</p>
          <p class="text-4xl font-light [font-feature-settings:'ss01']">Queen Quartz</p>
          <p class="small text-muted mt-2">
            Ligatures and calligraphic forms, for display sizes only. <a class="link" href="#opentype">Every feature, off and on</a>.
          </p>
        </div>
      </div>
    </section>

    <section class="rule-thick mb-20 pt-6" aria-labelledby="color">
      <p class="label text-copper-text">Color</p>
      <h2 class="h2 mb-4" id="color">Patina and copper</h2>
      <p class="mb-10 max-w-3xl">
        Each swatch is drawn with its token's utility, so it shows this theme's value. Both values are listed under it,
        with the contrast against the color it is read on.
      </p>
      {
        groups.map(({ title, swatches }) => (
          <div class="mb-12">
            <h3 class="title mb-4">{title}</h3>
            <ul class="grid gap-x-6 gap-y-8 sm:grid-cols-2 lg:grid-cols-4">
              {swatches.map((s) => (
                <li>
                  <div class:list={['h-24 border border-rule', s.chip]} aria-hidden="true" />
                  <p class="mt-3 font-semibold">{s.name}</p>
                  <p class="small"><code>{s.utilities}</code></p>
                  <p class="small num text-muted">
                    Light {hex(s.name, 'light')}
                    {s.against && `, ${ratio(s.name, s.against, 'light')}`}
                    <br />
                    Dark {hex(s.name, 'dark')}
                    {s.against && `, ${ratio(s.name, s.against, 'dark')}`}
                    {s.against && <br />}
                    {s.against && `on ${s.against}`}
                  </p>
                  <p class="small mt-1">{s.use}</p>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </section>

    <section class="rule-thick mb-20 pt-6" aria-labelledby="in-use">
      <p class="label text-copper-text">In use</p>
      <h2 class="h2 mb-8" id="in-use">Each color doing its job</h2>
      <div class="grid gap-8 md:grid-cols-2">
        <div class="border border-rule p-6">
          <h3 class="label mb-4">On paper</h3>
          <p class="text-ink">Ink sets the body and the headings.</p>
          <p class="text-muted">Muted sets the meta under them.</p>
          <p><a class="link" href="#color">A verdigris link</a>, in <code>text-accent-text</code>.</p>
          <p class="label text-copper-text">A copper label</p>
          <p class="mt-4 flex flex-wrap items-baseline gap-x-6">
            <span class="text-5xl font-light text-accent">Patina</span>
            <span class="text-5xl font-light text-copper">Copper</span>
          </p>
          <p class="small text-muted">Accent and copper at large sizes only.</p>
          <hr class="my-4 border-0 border-t border-rule" />
          <p class="small text-muted">A rule divider above, in <code>border-rule</code>.</p>
        </div>
        <div class="bg-bar p-6 text-bar-ink">
          <h3 class="label mb-4 text-copper-bright">On a bar</h3>
          <p>Bar ink sets the text.</p>
          <p class="text-accent-bright">Bright verdigris marks the current item.</p>
          <p class="text-copper-bright">Bright copper sets labels and ornament.</p>
        </div>
        <div class="flex flex-wrap items-center gap-4 md:col-span-2">
          <p class="bg-accent-text px-6 py-3 font-semibold text-accent-ink">Accent ink on a verdigris fill</p>
          <a class="btn" href="#type">Primary button</a>
          <a class="btn-outline" href="#color">Secondary button</a>
        </div>
      </div>
    </section>

    <section class="rule-thick mb-20 pt-6" aria-labelledby="opentype">
      <p class="label text-copper-text">OpenType</p>
      <h2 class="h2 mb-4" id="opentype">Every feature, off and on</h2>
      <div class="mb-10 max-w-3xl [&>p]:mb-4">
        <p>
          OpenType features are optional glyphs built into the font: ligatures, alternate letters, other kinds of
          figures. CSS switches them on with <code>font-feature-settings</code>, or with a
          <code>font-variant-*</code> property where there is one. Each card shows a feature off and on, then one
          sample you can switch between the two.
        </p>
        <p>
          Verdigris already sets a few: <code>ss02</code> on body text, <code>dlig</code> on headings, old-style
          figures in text and lining tabular figures in <code>.num</code>. The samples here start from the font's
          own defaults, so each card shows one feature alone.
        </p>
        <p class="notice">
          Keep ligatures and other heavy features to display text. A ligature can confuse a screen reader, and
          copy and paste, when it stands for more than one letter.
        </p>
        <p>
          <span class="font-semibold">Building a site with an agent?</span> The rules for these features, and how to
          set them so they stack, are in
          <a class="link" href={`${doc('DESIGN.md')}#opentype-features`}>DESIGN.md, under OpenType features</a>.
          Point your agent there rather than copying CSS from this page.
        </p>
      </div>

      {
        otGroups.map((g) => (
          <div class="mb-16 border-t-2 border-ink pt-4" aria-labelledby={g.id}>
            <h3 class="title" id={g.id}>{g.title}</h3>
            {g.intro && <p class="mt-1 max-w-3xl">{g.intro}</p>}
            {g.trio && (
              <ul class:list={['ot ot-trio mt-6 grid grid-cols-3 gap-4 border-b border-rule pb-6 text-center', g.trio.italic && 'italic']}>
                {[undefined, ...g.trio.tags].map((tag) => (
                  <li>
                    <span class="ot-trio-glyph" style={tag && `font-feature-settings: "${tag}" 1`}>{g.trio!.glyph}</span>
                    <span class="small block text-muted">{tag ? <code>{tag}</code> : 'Default'}</span>
                  </li>
                ))}
              </ul>
            )}
            {g.features.map((f) => (
              <article class="ot-card" aria-labelledby={`ot-${f.tag}`}>
                <h4 class="font-semibold" id={`ot-${f.tag}`}>
                  <code>{f.tag}</code> {f.name}
                </h4>
                <p class="mt-1 max-w-3xl">{f.does}</p>

                <div class="mt-5 grid gap-6 md:grid-cols-2">
                  {states(f).map((s) => (
                    <div class="border-t border-rule pt-3">
                      <p class="small mb-2 font-semibold">{s.label}</p>
                      <div class:list={['ot', f.face === 'italic' && 'italic']} style={`--ot-ff: ${s.value}`}>
                        {f.table ? (
                          <table class="ot-table">
                            <caption class="sr-only">Prices, {s.label.toLowerCase()}</caption>
                            <tbody>
                              {prices.map(([item, price]) => (
                                <tr>
                                  <th scope="row">{item}</th>
                                  <td class="ot-f">{price}</td>
                                </tr>
                              ))}
                            </tbody>
                          </table>
                        ) : (
                          <p class="ot-sample">
                            {partial(f) ? f.sample.map((p) => (p.on ? <span class="ot-f">{p.text}</span> : p.text)) : <span class="ot-f">{f.sample[0].text}</span>}
                          </p>
                        )}
                        {f.alphabet && <p class="ot-alpha ot-f">{alphabet}</p>}
                      </div>
                    </div>
                  ))}
                </div>

                {!f.table && (
                  <div
                    class="mt-6 border border-rule p-5 md:p-6"
                    data-ot-compare
                    data-on={f.onByDefault ? states(f)[0].value : states(f)[1].value}
                    data-off={f.onByDefault ? states(f)[1].value : states(f)[0].value}
                  >
                    <label class="choice mb-3">
                      <input class="switch" type="checkbox" role="switch" checked={f.onByDefault} data-ot-toggle />
                      <code>{f.tag}</code>
                      <span class="sr-only">{f.name}</span>
                    </label>
                    <div class:list={['ot', f.face === 'italic' && 'italic']} style={`--ot-ff: ${states(f)[0].value}`} data-ot-sample>
                      <p class="ot-sample ot-sample--big">
                        {partial(f) ? f.sample.map((p) => (p.on ? <span class="ot-f">{p.text}</span> : p.text)) : <span class="ot-f">{f.sample[0].text}</span>}
                      </p>
                    </div>
                  </div>
                )}

              </article>
            ))}
          </div>
        ))
      }

      <div class="max-w-3xl border-t-2 border-ink pt-4">
        <h3 class="title">Left out</h3>
        <p class="mt-1">The font has these too. They are not on this page:</p>
        <ul class="mt-3 list-disc pl-6">
          {leftOut.map((l) => <li class="mb-2"><span class="font-semibold">{l.tags}.</span> {l.why}</li>)}
        </ul>
      </div>
    </section>

    <section class="rule-thick mb-20 pt-6" aria-labelledby="playground">
      <p class="label text-copper-text">Playground</p>
      <h2 class="h2 mb-4" id="playground">Try them together</h2>
      <p class="mb-10 max-w-3xl">
        Type something, set the weight and style, and switch features on. The line under the sample shows how they stack.
      </p>
      <form class="grid gap-10 lg:grid-cols-[1fr_2fr]" data-play>
        <div class="flex flex-col gap-8">
          <div>
            <label class="field-label" for="play-text">Sample text</label>
            <input class="field" id="play-text" type="text" value="Agent & Art" autocomplete="off" data-play-text />
          </div>
          <div>
            <label class="field-label" for="play-weight">Weight <output for="play-weight" data-play-weight-out>300</output></label>
            <input class="mt-3 w-full accent-accent-text" id="play-weight" type="range" min="300" max="700" step="10" value="300" data-play-weight />
          </div>
          <fieldset class="choice-group choice-group--row">
            <legend class="field-label">Style</legend>
            <label class="choice"><input class="radio" type="radio" name="play-style" value="normal" checked data-play-style /> Upright</label>
            <label class="choice"><input class="radio" type="radio" name="play-style" value="italic" data-play-style /> Italic</label>
          </fieldset>
          <fieldset class="min-w-0 border-0 p-0">
            <legend class="field-label mb-3">Features</legend>
            <div class="chip-group">
              {
                features.map((f) => (
                  <button class="chip" type="button" aria-pressed="false" data-play-tag={f.tag} data-face={f.face} data-value={f.onByDefault ? 0 : 1}>
                    <code>{f.tag}</code>
                    {f.onByDefault && ' off'}
                  </button>
                ))
              }
            </div>
            <p class="small mt-3 text-muted" data-play-note aria-live="polite"></p>
          </fieldset>
        </div>
        <div class="min-w-0">
          <p class="ot ot-play" data-play-sample aria-live="off">Agent &amp; Art</p>
          <p class="label mt-8 mb-2">CSS for this sample</p>
          <pre><code data-play-code></code></pre>
        </div>
      </form>
    </section>

    <section class="rule-thick pt-6" aria-labelledby="glyphs">
      <p class="label text-copper-text">Glyphs</p>
      <h2 class="h2 mb-4" id="glyphs">Ornaments, arrows and signs</h2>
      <p class="mb-10 max-w-3xl">
        Cormorant draws a few ornaments of its own, and the usual arrows, shapes and signs. These are all in the
        font, so they match the text around them. Reach for one here before an icon or a drawing.
      </p>
      {
        glyphGroups.map((g) => (
          <div class="mb-12 border-t-2 border-ink pt-4" aria-labelledby={g.id}>
            <h3 class="title" id={g.id}>{g.title}</h3>
            <p class="mt-1 max-w-3xl">{g.use}</p>
            <ul class="glyph-grid mt-5">
              {[...g.chars].map((c) => (
                <li>
                  <span class="glyph">{c}</span>
                  <span class="small num text-muted">{codePoint(c)}</span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </section>
  </div>
</SiteLayout>

<script>
  // Each card's single sample: the switch turns the feature on and off. Set from the switch on
  // load too, in case the browser restored a switch's state from an earlier visit.
  for (const box of document.querySelectorAll<HTMLElement>('[data-ot-compare]')) {
    const toggle = box.querySelector<HTMLInputElement>('[data-ot-toggle]')!;
    const sample = box.querySelector<HTMLElement>('[data-ot-sample]')!;
    const apply = () => sample.style.setProperty('--ot-ff', toggle.checked ? box.dataset.on! : box.dataset.off!);
    toggle.addEventListener('change', apply);
    apply();
  }

  // The playground. Each feature sets its own custom property, and .ot-play lists them all in one
  // font-feature-settings, so they stack.
  const form = document.querySelector<HTMLFormElement>('[data-play]');
  if (form) {
    const text = form.querySelector<HTMLInputElement>('[data-play-text]')!;
    const weight = form.querySelector<HTMLInputElement>('[data-play-weight]')!;
    const weightOut = form.querySelector('[data-play-weight-out]')!;
    const sample = form.querySelector<HTMLElement>('[data-play-sample]')!;
    const code = form.querySelector('[data-play-code]')!;
    const note = form.querySelector('[data-play-note]')!;
    const chips = [...form.querySelectorAll<HTMLButtonElement>('[data-play-tag]')];
    const style = () => form.querySelector<HTMLInputElement>('[data-play-style]:checked')!.value;

    const render = () => {
      const italic = style() === 'italic';
      const missing: string[] = [];
      for (const chip of chips) {
        const face = chip.dataset.face;
        const absent = (italic && face === 'upright') || (!italic && face === 'italic');
        chip.disabled = absent;
        if (absent) {
          chip.setAttribute('aria-pressed', 'false');
          missing.push(chip.dataset.playTag!);
        }
        const on = chip.getAttribute('aria-pressed') === 'true';
        const prop = `--ot-${chip.dataset.playTag}`;
        if (on) sample.style.setProperty(prop, `"${chip.dataset.playTag}" ${chip.dataset.value}`);
        else sample.style.removeProperty(prop);
      }
      note.textContent = missing.length
        ? `Not in the ${italic ? 'italic' : 'upright'}: ${missing.join(', ')}.`
        : '';
      sample.textContent = text.value || ' ';
      sample.style.fontWeight = weight.value;
      sample.style.fontStyle = style();
      weightOut.textContent = weight.value;
      const on = chips.filter((c) => c.getAttribute('aria-pressed') === 'true');
      const settings = on.length ? on.map((c) => `"${c.dataset.playTag}" ${c.dataset.value}`).join(', ') : 'normal';
      code.textContent = `font-weight: ${weight.value};\nfont-style: ${style()};\nfont-feature-settings: ${settings};`;
    };

    for (const chip of chips) {
      chip.addEventListener('click', () => {
        chip.setAttribute('aria-pressed', String(chip.getAttribute('aria-pressed') !== 'true'));
        render();
      });
    }
    form.addEventListener('input', render);
    form.addEventListener('submit', (e) => e.preventDefault());
    render();
  }
</script>

<style>
  .type-row {
    display: grid;
    gap: 0.25rem 2rem;
    align-items: baseline;
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--rule);
  }
  .type-row:last-child { border-bottom: 0; }
  @media (min-width: 768px) {
    .type-row { grid-template-columns: 1fr 2fr 1fr; }
  }
  .type-row .display { font-size: clamp(4.75rem, 9vw, 7rem); }

  /* OpenType samples start from the font's own defaults: no inherited ss02 or old-style figures.
     .ot-f is the text a feature applies to; its value comes from --ot-ff on the sample. */
  .ot { font-variant: normal; font-feature-settings: normal; }
  .ot-f { font-feature-settings: var(--ot-ff, normal); }
  .ot-card { padding: 2rem 0; border-bottom: 1px solid var(--rule); }
  .ot-card:last-child { border-bottom: 0; }

---
// The site's mark in the top bar, in place of its name (Mark under TopBar in COMPONENTS.md): the
// initials in the kit's oval badge (Ellipse), in the accent. The badge's label is the site's
// name, so screen readers hear "Agentic Design Kits" and a pointer gets it as a tooltip.
import Ellipse from '@agentic-design-kits/swiss-minimal/astro/Ellipse.astro';
---

<Ellipse code="ADK" label="Agentic Design Kits" accent class="site-mark" />

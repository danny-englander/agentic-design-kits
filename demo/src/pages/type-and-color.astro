---
// The type styles and every color token, drawn with the kit's own classes and token utilities,
// so the page shows what a site can use. The values and contrast ratios come from tokens.json.
import SiteLayout from '../layouts/SiteLayout.astro';
import PageTitle from '@agentic-design-kits/swiss-minimal/astro/PageTitle.astro';
import tokens from '../../../tokens.json';

type Theme = 'light' | 'dark';
type Accent = 'vermilion' | 'verdigris';
type Values = Record<Theme, string>;
const values = new Map(tokens.color.tokens.map((t) => [t.name, t.value as Values]));
/** The accent tokens Verdigris swaps in; every other token stays. */
const verdigris = new Map(
  Object.entries(tokens.color.accents.find((a) => a.id === 'verdigris')?.tokens ?? {}) as [string, Values][],
);
/** A token's color in one theme and accent, following references such as "{bar}". */
const hex = (name: string, theme: Theme, accent: Accent = 'vermilion'): string => {
  const v = (accent === 'verdigris' && verdigris.get(name)?.[theme]) || values.get(name)?.[theme] || '';
  return v.startsWith('{') ? hex(v.slice(1, -1), theme, accent) : v;
};
const luminance = (h: string) => {
  const [r, g, b] = [1, 3, 5].map((i) => {
    const c = parseInt(h.slice(i, i + 2), 16) / 255;
    return c <= 0.03928 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4;
  });
  return 0.2126 * r + 0.7152 * g + 0.0722 * b;
};
const ratio = (a: string, b: string, theme: Theme, accent: Accent = 'vermilion') => {
  const [hi, lo] = [luminance(hex(a, theme, accent)), luminance(hex(b, theme, accent))].sort((x, y) => y - x);
  return `${((hi + 0.05) / (lo + 0.05)).toFixed(1)}:1`;
};
/** One accent's light and dark values for a swatch, with contrast where it is read on something. */
const line = (s: Swatch, theme: Theme, accent?: Accent) =>
  `${theme === 'light' ? 'Light' : 'Dark'} ${hex(s.name, theme, accent)}` +
  (s.against ? `, ${ratio(s.name, s.against, theme, accent)}` : '');

interface Swatch {
  name: string;
  /** The utilities a site writes. Literal, so Tailwind generates them. */
  utilities: string;
  chip: string;
  use: string;
  /** The token this color is read against, for the contrast ratio. */
  against?: string;
}
const groups: { title: string; accent?: boolean; swatches: Swatch[] }[] = [
  {
    title: 'The page',
    swatches: [
      { name: 'paper', utilities: 'bg-paper', chip: 'bg-paper', use: 'The page background.' },
      { name: 'ink', utilities: 'text-ink, bg-ink', chip: 'bg-ink', use: 'Body text, headings and the thick rules.', against: 'paper' },
      { name: 'muted', utilities: 'text-muted', chip: 'bg-muted', use: 'Secondary text: dates, counts, sublines.', against: 'paper' },
      { name: 'rule', utilities: 'border-rule', chip: 'bg-rule', use: 'Thin row dividers. Decorative, never the only edge of a control.', against: 'paper' },
    ],
  },
  {
    title: 'Accent',
    accent: true,
    swatches: [
      { name: 'accent-text', utilities: 'text-accent-text, bg-accent-text', chip: 'bg-accent-text', use: 'Small accent text and links, and the primary button.', against: 'paper' },
      { name: 'accent', utilities: 'text-accent, bg-accent', chip: 'bg-accent', use: 'Large shapes and the focus ring only, never small text.', against: 'paper' },
      { name: 'accent-ink', utilities: 'text-accent-ink', chip: 'bg-accent-ink', use: 'Text on an accent fill.', against: 'accent-text' },
      { name: 'accent-bright', utilities: 'text-accent-bright', chip: 'bg-accent-bright', use: 'Accent text and marks on a bar.', against: 'bar' },
    ],
  },
  {
    title: 'Bars',
    swatches: [
      { name: 'bar', utilities: 'bg-bar', chip: 'bg-bar', use: 'Surfaces that stay dark in both themes: the panel, drawer and toast.' },
      { name: 'bar-ink', utilities: 'text-bar-ink', chip: 'bg-bar-ink', use: 'Text on a bar.', against: 'bar' },
    ],
  },
];
---

<SiteLayout title="Type and color" description="Swiss Minimal's type styles and every color token, in light and dark.">
  <PageTitle title="Type and color" />
  <div class="pb-16">
    <p class="lead mb-16 max-w-3xl">
      Every style and color here is drawn with the kit's own classes and token utilities. Switch the theme in the top
      bar, or the accent under the gear, and the whole page follows.
    </p>

    <section class="rule-thick mb-20 pt-6" aria-labelledby="type">
      <p class="label text-accent-text">Type</p>
      <h2 class="h2 mb-8" id="type">One grotesque, size and weight</h2>
      <dl class="border-t-2 border-ink">
        <div class="type-row">
          <dt class="label">Display</dt>
          <dd class="display">Swiss</dd>
          <dd class="small muted"><code>.display</code>, 700</dd>
        </div>
        <div class="type-row">
          <dt class="label">Heading</dt>
          <dd class="h2">Selected work</dd>
          <dd class="small muted"><code>.h2</code>, 700</dd>
        </div>
        <div class="type-row">
          <dt class="label">Title</dt>
          <dd class="title">Field notes</dd>
          <dd class="small muted"><code>.title</code>, 700</dd>
        </div>
        <div class="type-row">
          <dt class="label">Lead</dt>
          <dd class="lead">Flat color, thick rules, one typeface.</dd>
          <dd class="small muted"><code>.lead</code>, 400</dd>
        </div>
        <div class="type-row">
          <dt class="label">Body</dt>
          <dd>Type does the work. Nothing is decorative: a heading is a heading because of its size, not its color or its box.</dd>
          <dd class="small muted">400, line height 1.8</dd>
        </div>
        <div class="type-row">
          <dt class="label">Label</dt>
          <dd class="label">Archive</dd>
          <dd class="small muted"><code>.label</code>, 500, capitals, one or two words</dd>
        </div>
        <div class="type-row">
          <dt class="label">Small</dt>
          <dd class="small muted">The floor: 13 November 2026, 3 items, set at 14px</dd>
          <dd class="small muted"><code>.small</code>, 14px at least</dd>
        </div>
      </dl>
      <div class="mt-12 grid gap-8 md:grid-cols-3">
        <div class="border-t-2 border-ink pt-3">
          <h3 class="label mb-2">Figures</h3>
          <p class="text-4xl font-bold">1234567890</p>
          <p class="num text-4xl font-bold">1234567890</p>
          <p class="small muted mt-2">Proportional in text, tabular with <code>.num</code>.</p>
        </div>
        <div class="border-t-2 border-ink pt-3">
          <h3 class="label mb-2">Three weights</h3>
          <p class="text-4xl">Regular 400</p>
          <p class="text-4xl font-medium">Medium 500</p>
          <p class="text-4xl font-bold">Bold 700</p>
          <p class="small muted mt-2">Body, then labels and chrome, then headings and names.</p>
        </div>
        <div class="border-t-2 border-ink pt-3">
          <h3 class="label mb-2">Code</h3>
          <p class="text-2xl"><code>const grid = 12;</code></p>
          <p class="small muted mt-2">Source Code Pro, for <code>code</code> and <code>pre</code> only.</p>
        </div>
      </div>
    </section>

    <section class="rule-thick mb-20 pt-6" aria-labelledby="color">
      <p class="label text-accent-text">Color</p>
      <h2 class="h2 mb-4" id="color">Paper, ink and one accent</h2>
      <p class="mb-10 max-w-3xl">
        Each swatch is drawn with its token's utility, so it shows this theme and accent. Both theme values are listed
        under it, with the contrast against the color it is read on. Accent swatches list vermilion's values and
        verdigris's.
      </p>
      {
        groups.map(({ title, accent, swatches }) => (
          <div class="mb-12">
            <h3 class="title mb-4">{title}</h3>
            <ul class="grid gap-x-6 gap-y-8 sm:grid-cols-2 lg:grid-cols-4">
              {swatches.map((s) => (
                <li>
                  <div class:list={['h-24 border border-rule', s.chip]} aria-hidden="true" />
                  <p class="mt-3 font-bold">{s.name}</p>
                  <p class="small"><code>{s.utilities}</code></p>
                  {accent ? (
                    (['vermilion', 'verdigris'] as const).map((a) => (
                      <p class="small num muted">
                        {a === 'vermilion' ? 'Vermilion' : 'Verdigris'}
                        <br />
                        {line(s, 'light', a)}
                        <br />
                        {line(s, 'dark', a)}
                      </p>
                    ))
                  ) : (
                    <p class="small num muted">
                      {line(s, 'light')}
                      <br />
                      {line(s, 'dark')}
                    </p>
                  )}
                  {s.against && <p class="small num muted">on {s.against}</p>}
                  <p class="small mt-1">{s.use}</p>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </section>

    <section class="rule-thick pt-6" aria-labelledby="in-use">
      <p class="label text-accent-text">In use</p>
      <h2 class="h2 mb-8" id="in-use">Each color doing its job</h2>
      <div class="grid gap-8 md:grid-cols-2">
        <div class="border border-rule p-6">
          <h3 class="label mb-4">On paper</h3>
          <p class="text-ink">Ink sets the body and the headings.</p>
          <p class="muted">Muted sets the meta under them.</p>
          <p><a class="link" href="#color">An accent link</a>, in <code>text-accent-text</code>.</p>
          <p class="label text-accent-text">A label</p>
          <p class="mt-4 text-5xl font-bold text-accent">Accent</p>
          <p class="small muted">The plain accent at large sizes only.</p>
          <hr class="my-4 border-0 border-t border-rule" />
          <p class="small muted">A rule divider above, in <code>border-rule</code>.</p>
        </div>
        <div class="bg-bar p-6 text-bar-ink">
          <h3 class="label mb-4 text-accent-bright">On a bar</h3>
          <p>Bar ink sets the text.</p>
          <p class="text-accent-bright">The bright accent marks the current item.</p>
        </div>
        <div class="flex flex-wrap items-center gap-4 md:col-span-2">
          <p class="bg-accent-text px-6 py-3 font-bold text-accent-ink">Accent ink on an accent fill</p>
          <a class="btn" href="#type">Primary button</a>
          <a class="btn-outline" href="#color">Secondary button</a>
        </div>
      </div>
    </section>
  </div>
</SiteLayout>

<style>
  .type-row {
    display: grid;
    gap: 0.25rem 2rem;
    align-items: baseline;
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--rule);
  }
  .type-row:last-child { border-bottom: 0; }
  @media (min-width: 768px) {
    .type-row { grid-template-columns: 1fr 2fr 1fr; }
  }
  .type-row .display { font-size: clamp(4rem, 9vw, 7rem); }
</style>

---
// The type styles and every color token, drawn with the kit's own classes and token utilities,
// so the page shows what a site can use. The values and contrast ratios come from tokens.json.
import SiteLayout from '../layouts/SiteLayout.astro';
import PageTitle from '@agentic-design-kits/swiss-minimal/astro/PageTitle.astro';
import tokens from '../../../tokens.json';
import { groups as otGroups, features, leftOut, type Feature } from '../data/opentype';
import { doc } from '../data/prompts';
import { glyphGroups, codePoint } from '../data/glyphs';

/** Whether the feature applies to the whole sample, or only to its marked parts. */
const partial = (f: Feature) => f.sample.some((p) => p.on);
const on = (f: Feature) => `"${f.tag}" 1`;
const prices = [
  ['Coffee', '3.50'],
  ['Bread', '11.20'],
  ['Cheese', '7.85'],
  ['Wine', '18.00'],
  ['Olives', '4.10'],
];

type Theme = 'light' | 'dark';
type Accent = 'vermilion' | 'verdigris';
type Values = Record<Theme, string>;
const values = new Map(tokens.color.tokens.map((t) => [t.name, t.value as Values]));
/** The accent tokens Verdigris swaps in; every other token stays. */
const verdigris = new Map(
  Object.entries(tokens.color.accents.find((a) => a.id === 'verdigris')?.tokens ?? {}) as [string, Values][],
);
/** A token's color in one theme and accent, following references such as "{bar}". */
const hex = (name: string, theme: Theme, accent: Accent = 'vermilion'): string => {
  const v = (accent === 'verdigris' && verdigris.get(name)?.[theme]) || values.get(name)?.[theme] || '';
  return v.startsWith('{') ? hex(v.slice(1, -1), theme, accent) : v;
};
const luminance = (h: string) => {
  const [r, g, b] = [1, 3, 5].map((i) => {
    const c = parseInt(h.slice(i, i + 2), 16) / 255;
    return c <= 0.03928 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4;
  });
  return 0.2126 * r + 0.7152 * g + 0.0722 * b;
};
const ratio = (a: string, b: string, theme: Theme, accent: Accent = 'vermilion') => {
  const [hi, lo] = [luminance(hex(a, theme, accent)), luminance(hex(b, theme, accent))].sort((x, y) => y - x);
  return `${((hi + 0.05) / (lo + 0.05)).toFixed(1)}:1`;
};
/** One accent's light and dark values for a swatch, with contrast where it is read on something. */
const line = (s: Swatch, theme: Theme, accent?: Accent) =>
  `${theme === 'light' ? 'Light' : 'Dark'} ${hex(s.name, theme, accent)}` +
  (s.against ? `, ${ratio(s.name, s.against, theme, accent)}` : '');

interface Swatch {
  name: string;
  /** The utilities a site writes. Literal, so Tailwind generates them. */
  utilities: string;
  chip: string;
  use: string;
  /** The token this color is read against, for the contrast ratio. */
  against?: string;
}
const groups: { title: string; accent?: boolean; swatches: Swatch[] }[] = [
  {
    title: 'The page',
    swatches: [
      { name: 'paper', utilities: 'bg-paper', chip: 'bg-paper', use: 'The page background.' },
      { name: 'ink', utilities: 'text-ink, bg-ink', chip: 'bg-ink', use: 'Body text, headings and the thick rules.', against: 'paper' },
      { name: 'muted', utilities: 'text-muted', chip: 'bg-muted', use: 'Secondary text: dates, counts, sublines.', against: 'paper' },
      { name: 'rule', utilities: 'border-rule', chip: 'bg-rule', use: 'Thin row dividers. Decorative, never the only edge of a control.', against: 'paper' },
    ],
  },
  {
    title: 'Accent',
    accent: true,
    swatches: [
      { name: 'accent-text', utilities: 'text-accent-text, bg-accent-text', chip: 'bg-accent-text', use: 'Small accent text and links, and the primary button.', against: 'paper' },
      { name: 'accent', utilities: 'text-accent, bg-accent', chip: 'bg-accent', use: 'Large shapes and the focus ring only, never small text.', against: 'paper' },
      { name: 'accent-ink', utilities: 'text-accent-ink', chip: 'bg-accent-ink', use: 'Text on an accent fill.', against: 'accent-text' },
      { name: 'accent-bright', utilities: 'text-accent-bright', chip: 'bg-accent-bright', use: 'Accent text and marks on a bar.', against: 'bar' },
    ],
  },
  {
    title: 'Bars',
    swatches: [
      { name: 'bar', utilities: 'bg-bar', chip: 'bg-bar', use: 'Surfaces that stay dark in both themes: the panel, drawer and toast.' },
      { name: 'bar-ink', utilities: 'text-bar-ink', chip: 'bg-bar-ink', use: 'Text on a bar.', against: 'bar' },
    ],
  },
];
---

<SiteLayout title="Type and color" description="Swiss Minimal's type styles and every color token, in light and dark.">
  <PageTitle title="Type and color" />
  <div class="pb-16">
    <p class="lead mb-16 max-w-3xl">
      Every style and color here is drawn with the kit's own classes and token utilities. Switch the theme in the top
      bar, or the accent under the gear, and the whole page follows.
    </p>

    <section class="rule-thick mb-20 pt-6" aria-labelledby="type">
      <p class="label text-accent-text">Type</p>
      <h2 class="h2 mb-8" id="type">One grotesque, size and weight</h2>
      <dl class="border-t-2 border-ink">
        <div class="type-row">
          <dt class="label">Display</dt>
          <dd class="display">Swiss</dd>
          <dd class="small muted"><code>.display</code>, 700</dd>
        </div>
        <div class="type-row">
          <dt class="label">Heading</dt>
          <dd class="h2">Selected work</dd>
          <dd class="small muted"><code>.h2</code>, 700</dd>
        </div>
        <div class="type-row">
          <dt class="label">Title</dt>
          <dd class="title">Field notes</dd>
          <dd class="small muted"><code>.title</code>, 700</dd>
        </div>
        <div class="type-row">
          <dt class="label">Lead</dt>
          <dd class="lead">Flat color, thick rules, one typeface.</dd>
          <dd class="small muted"><code>.lead</code>, 400</dd>
        </div>
        <div class="type-row">
          <dt class="label">Body</dt>
          <dd>Type does the work. Nothing is decorative: a heading is a heading because of its size, not its color or its box.</dd>
          <dd class="small muted">400, line height 1.8</dd>
        </div>
        <div class="type-row">
          <dt class="label">Label</dt>
          <dd class="label">Archive</dd>
          <dd class="small muted"><code>.label</code>, 500, capitals, one or two words</dd>
        </div>
        <div class="type-row">
          <dt class="label">Small</dt>
          <dd class="small muted">The floor: 13 November 2026, 3 items, set at 14px</dd>
          <dd class="small muted"><code>.small</code>, 14px at least</dd>
        </div>
      </dl>
      <div class="mt-12 grid gap-8 md:grid-cols-3">
        <div class="border-t-2 border-ink pt-3">
          <h3 class="label mb-2">Figures</h3>
          <p class="text-4xl font-bold">1234567890</p>
          <p class="num text-4xl font-bold">1234567890</p>
          <p class="small muted mt-2">
            Proportional in text, tabular with <code>.num</code>. <a class="link" href="#opentype">Every OpenType feature</a>.
          </p>
        </div>
        <div class="border-t-2 border-ink pt-3">
          <h3 class="label mb-2">Three weights</h3>
          <p class="text-4xl">Regular 400</p>
          <p class="text-4xl font-medium">Medium 500</p>
          <p class="text-4xl font-bold">Bold 700</p>
          <p class="small muted mt-2">Body, then labels and chrome, then headings and names.</p>
        </div>
        <div class="border-t-2 border-ink pt-3">
          <h3 class="label mb-2">Code</h3>
          <p class="text-2xl"><code>const grid = 12;</code></p>
          <p class="small muted mt-2">Source Code Pro, for <code>code</code> and <code>pre</code> only.</p>
        </div>
      </div>
    </section>

    <section class="rule-thick mb-20 pt-6" aria-labelledby="color">
      <p class="label text-accent-text">Color</p>
      <h2 class="h2 mb-4" id="color">Paper, ink and one accent</h2>
      <p class="mb-10 max-w-3xl">
        Each swatch is drawn with its token's utility, so it shows this theme and accent. Both theme values are listed
        under it, with the contrast against the color it is read on. Accent swatches list vermilion's values and
        verdigris's.
      </p>
      {
        groups.map(({ title, accent, swatches }) => (
          <div class="mb-12">
            <h3 class="title mb-4">{title}</h3>
            <ul class="grid gap-x-6 gap-y-8 sm:grid-cols-2 lg:grid-cols-4">
              {swatches.map((s) => (
                <li>
                  <div class:list={['h-24 border border-rule', s.chip]} aria-hidden="true" />
                  <p class="mt-3 font-bold">{s.name}</p>
                  <p class="small"><code>{s.utilities}</code></p>
                  {accent ? (
                    (['vermilion', 'verdigris'] as const).map((a) => (
                      <p class="small num muted">
                        {a === 'vermilion' ? 'Vermilion' : 'Verdigris'}
                        <br />
                        {line(s, 'light', a)}
                        <br />
                        {line(s, 'dark', a)}
                      </p>
                    ))
                  ) : (
                    <p class="small num muted">
                      {line(s, 'light')}
                      <br />
                      {line(s, 'dark')}
                    </p>
                  )}
                  {s.against && <p class="small num muted">on {s.against}</p>}
                  <p class="small mt-1">{s.use}</p>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </section>

    <section class="rule-thick mb-20 pt-6" aria-labelledby="in-use">
      <p class="label text-accent-text">In use</p>
      <h2 class="h2 mb-8" id="in-use">Each color doing its job</h2>
      <div class="grid gap-8 md:grid-cols-2">
        <div class="border border-rule p-6">
          <h3 class="label mb-4">On paper</h3>
          <p class="text-ink">Ink sets the body and the headings.</p>
          <p class="muted">Muted sets the meta under them.</p>
          <p><a class="link" href="#color">An accent link</a>, in <code>text-accent-text</code>.</p>
          <p class="label text-accent-text">A label</p>
          <p class="mt-4 text-5xl font-bold text-accent">Accent</p>
          <p class="small muted">The plain accent at large sizes only.</p>
          <hr class="my-4 border-0 border-t border-rule" />
          <p class="small muted">A rule divider above, in <code>border-rule</code>.</p>
        </div>
        <div class="bg-bar p-6 text-bar-ink">
          <h3 class="label mb-4 text-accent-bright">On a bar</h3>
          <p>Bar ink sets the text.</p>
          <p class="text-accent-bright">The bright accent marks the current item.</p>
        </div>
        <div class="flex flex-wrap items-center gap-4 md:col-span-2">
          <p class="bg-accent-text px-6 py-3 font-bold text-accent-ink">Accent ink on an accent fill</p>
          <a class="btn" href="#type">Primary button</a>
          <a class="btn-outline" href="#color">Secondary button</a>
        </div>
      </div>
    </section>

    <section class="rule-thick mb-20 pt-6" aria-labelledby="opentype">
      <p class="label text-accent-text">OpenType</p>
      <h2 class="h2 mb-4" id="opentype">Every feature, off and on</h2>
      <div class="mb-10 max-w-3xl [&>p]:mb-4">
        <p>
          OpenType features are optional glyphs built into the font: alternate letters, other kinds of figures,
          fractions. CSS switches them on with <code>font-feature-settings</code>, or with a
          <code>font-variant-*</code> property where there is one. Each card shows a feature off and on, then one
          sample you can switch between the two.
        </p>
        <p>
          The kit sets none of them on text, except tabular figures in <code>.num</code>, so each card starts from
          the font's own defaults.
        </p>
        <p>
          <span class="font-bold">Features change how text looks, not what it says.</span> A screen reader still
          reads, and copy and paste still gives, the characters typed. So boxed and circled figures read as plain
          figures: don't rely on the box or circle to carry meaning.
        </p>
        <p>
          <span class="font-bold">Building a site with an agent?</span> The rules for these features, and how to set
          them so they stack, are in
          <a class="link" href={`${doc('DESIGN.md')}#opentype-features`}>DESIGN.md, under OpenType features</a>. Point
          your agent there rather than copying CSS from this page.
        </p>
      </div>

      {
        otGroups.map((g) => (
          <div class="mb-16 border-t-2 border-ink pt-4" aria-labelledby={g.id}>
            <h3 class="title" id={g.id}>{g.title}</h3>
            {g.intro && <p class="mt-1 max-w-3xl">{g.intro}</p>}
            {g.compare && (
              <dl class="ot mt-6 border-b border-rule pb-6">
                {[undefined, ...g.compare.tags].map((tag) => (
                  <div class="ot-compare-row">
                    <dt class="small muted">{tag ? <code>{tag}</code> : 'Default'}</dt>
                    <dd class="ot-compare-text" style={tag && `font-feature-settings: "${tag}" 1`}>{g.compare!.text}</dd>
                  </div>
                ))}
              </dl>
            )}
            {g.features.map((f) => (
              <article class="ot-card" aria-labelledby={`ot-${f.tag}`}>
                <h4 class="font-bold" id={`ot-${f.tag}`}>
                  <code>{f.tag}</code> {f.name}
                </h4>
                <p class="mt-1 max-w-3xl">{f.does}</p>

                <div class="mt-5 grid gap-6 md:grid-cols-2">
                  {[['Off', 'normal'], ['On', on(f)]].map(([label, value]) => (
                    <div class="border-t border-rule pt-3">
                      <p class="small mb-2 font-bold">{label}</p>
                      <div class="ot" style={`--ot-ff: ${value}`}>
                        {f.table ? (
                          <table class="ot-table">
                            <caption class="sr-only">Prices, {label.toLowerCase()}</caption>
                            <tbody>
                              {prices.map(([item, price]) => (
                                <tr>
                                  <th scope="row">{item}</th>
                                  <td class="ot-f">{price}</td>
                                </tr>
                              ))}
                            </tbody>
                          </table>
                        ) : (
                          <p class="ot-sample">
                            {partial(f) ? f.sample.map((p) => (p.on ? <span class="ot-f">{p.text}</span> : p.text)) : <span class="ot-f">{f.sample[0].text}</span>}
                          </p>
                        )}
                      </div>
                    </div>
                  ))}
                </div>

                {!f.table && (
                  <div class="mt-6 border border-rule p-5 md:p-6" data-ot-compare data-on={on(f)}>
                    <label class="choice mb-3">
                      <input class="switch" type="checkbox" role="switch" data-ot-toggle />
                      <code>{f.tag}</code>
                      <span class="sr-only">{f.name}</span>
                    </label>
                    <div class="ot" style="--ot-ff: normal" data-ot-sample>
                      <p class="ot-sample ot-sample--big">
                        {partial(f) ? f.sample.map((p) => (p.on ? <span class="ot-f">{p.text}</span> : p.text)) : <span class="ot-f">{f.sample[0].text}</span>}
                      </p>
                    </div>
                  </div>
                )}

              </article>
            ))}
          </div>
        ))
      }

      <div class="max-w-3xl border-t-2 border-ink pt-4">
        <h3 class="title">Left out</h3>
        <ul class="mt-3 list-disc pl-6">
          {leftOut.map((l) => <li class="mb-2"><span class="font-bold">{l.tags}.</span> {l.why}</li>)}
        </ul>
      </div>
    </section>

    <section class="rule-thick mb-20 pt-6" aria-labelledby="playground">
      <p class="label text-accent-text">Playground</p>
      <h2 class="h2 mb-4" id="playground">Try them together</h2>
      <p class="mb-10 max-w-3xl">
        Type something, set the weight, and switch features on. The line under the sample shows how they stack.
        Overused Grotesk is one variable font, so every weight from 300 to 900 is there.
      </p>
      <form class="grid gap-10 lg:grid-cols-[1fr_2fr]" data-play>
        <div class="flex flex-col gap-8">
          <div>
            <label class="field-label" for="play-text">Sample text</label>
            <input class="field" id="play-text" type="text" value="Agent & Art" autocomplete="off" data-play-text />
          </div>
          <div>
            <label class="field-label" for="play-weight">Weight <output for="play-weight" data-play-weight-out>400</output></label>
            <input class="mt-3 w-full accent-accent-text" id="play-weight" type="range" min="300" max="900" step="10" value="400" data-play-weight />
          </div>
          <fieldset class="min-w-0 border-0 p-0">
            <legend class="field-label mb-3">Features</legend>
            <div class="chip-group">
              {
                features.map((f) => (
                  <button class="chip" type="button" aria-pressed="false" data-play-tag={f.tag}>
                    <code>{f.tag}</code>
                  </button>
                ))
              }
            </div>
          </fieldset>
        </div>
        <div class="min-w-0">
          <p class="ot ot-play" data-play-sample>Agent &amp; Art</p>
          <p class="label mt-8 mb-2">CSS for this sample</p>
          <pre><code data-play-code></code></pre>
        </div>
      </form>
    </section>

    <section class="rule-thick pt-6" aria-labelledby="glyphs">
      <p class="label text-accent-text">Glyphs</p>
      <h2 class="h2 mb-4" id="glyphs">Arrows, shapes and signs</h2>
      <p class="mb-10 max-w-3xl">
        Overused Grotesk draws more than letters and figures. These are all in the font, so they match the text
        around them in weight and size. Reach for an arrow or a triangle here before an icon.
      </p>
      {
        glyphGroups.map((g) => (
          <div class="mb-12 border-t-2 border-ink pt-4" aria-labelledby={g.id}>
            <h3 class="title" id={g.id}>{g.title}</h3>
            <p class="mt-1 max-w-3xl">{g.use}</p>
            <ul class="glyph-grid mt-5">
              {[...g.chars].map((c) => (
                <li>
                  <span class="glyph">{c}</span>
                  <span class="small muted num">{codePoint(c)}</span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </section>
  </div>
</SiteLayout>

<script>
  // Each card's single sample: the switch turns the feature on and off. Set from the switch on
  // load too, in case the browser restored a switch's state from an earlier visit.
  for (const box of document.querySelectorAll<HTMLElement>('[data-ot-compare]')) {
    const toggle = box.querySelector<HTMLInputElement>('[data-ot-toggle]')!;
    const sample = box.querySelector<HTMLElement>('[data-ot-sample]')!;
    const apply = () => sample.style.setProperty('--ot-ff', toggle.checked ? box.dataset.on! : 'normal');
    toggle.addEventListener('change', apply);
    apply();
  }

  // The playground. Each feature sets its own custom property, and .ot-play lists them all in one
  // font-feature-settings, so they stack.
  const form = document.querySelector<HTMLFormElement>('[data-play]');
  if (form) {
    const text = form.querySelector<HTMLInputElement>('[data-play-text]')!;
    const weight = form.querySelector<HTMLInputElement>('[data-play-weight]')!;
    const weightOut = form.querySelector('[data-play-weight-out]')!;
    const sample = form.querySelector<HTMLElement>('[data-play-sample]')!;
    const code = form.querySelector('[data-play-code]')!;
    const chips = [...form.querySelectorAll<HTMLButtonElement>('[data-play-tag]')];

    const render = () => {
      for (const chip of chips) {
        const prop = `--ot-${chip.dataset.playTag}`;
        if (chip.getAttribute('aria-pressed') === 'true') sample.style.setProperty(prop, `"${chip.dataset.playTag}" 1`);
        else sample.style.removeProperty(prop);
      }
      sample.textContent = text.value || ' ';
      sample.style.fontWeight = weight.value;
      weightOut.textContent = weight.value;
      const on = chips.filter((c) => c.getAttribute('aria-pressed') === 'true');
      const settings = on.length ? on.map((c) => `"${c.dataset.playTag}" 1`).join(', ') : 'normal';
      code.textContent = `font-weight: ${weight.value};\nfont-feature-settings: ${settings};`;
    };

    for (const chip of chips) {
      chip.addEventListener('click', () => {
        chip.setAttribute('aria-pressed', String(chip.getAttribute('aria-pressed') !== 'true'));
        render();
      });
    }
    form.addEventListener('input', render);
    form.addEventListener('submit', (e) => e.preventDefault());
    render();
  }
</script>

<style>
  .type-row {
    display: grid;
    gap: 0.25rem 2rem;
    align-items: baseline;
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--rule);
  }
  .type-row:last-child { border-bottom: 0; }
  @media (min-width: 768px) {
    .type-row { grid-template-columns: 1fr 2fr 1fr; }
  }
  .type-row .display { font-size: clamp(4rem, 9vw, 7rem); }

  /* OpenType samples start from the font's own defaults. .ot-f is the text a feature applies to;
     its value comes from --ot-ff on the sample. */
  .ot { font-variant: normal; font-feature-settings: normal; }
  .ot-f { font-feature-settings: var(--ot-ff, normal); }
  .ot-card { padding: 2rem 0; border-bottom: 1px solid var(--rule); }
  .ot-card:last-child { border-bottom: 0; }
  .ot-sample { font-size: 2.25rem; line-height: 1.2; overflow-wrap: anywhere; }
  .ot-sample--big { font-size: clamp(2.75rem, 6vw, 4.5rem); line-height: 1.1; }
  .ot-table { font-size: 2.25rem; line-height: 1.25; border-collapse: collapse; }
  .ot-table th { padding-right: 2rem; text-align: left; font-weight: inherit; }
  .ot-table td { text-align: right; }
  .ot-compare-row { display: grid; align-items: baseline; padding-top: 0.5rem; }
  @media (min-width: 640px) { .ot-compare-row { grid-template-columns: 5rem 1fr; gap: 1rem; } }
  /* Boxed and circled figures are about 1em wide each, so ten fit a phone at 7.5vw. */
  .ot-compare-text { font-size: clamp(1.75rem, 7.5vw, 6rem); font-weight: 700; line-height: 1.15; white-space: nowrap; }

  /* Glyphs: a grid of cells, each the glyph large with its code point under it. */
  .glyph-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(5.5rem, 1fr)); border-top: 1px solid var(--rule); border-left: 1px solid var(--rule); }
  .glyph-grid li { display: flex; flex-direction: column; align-items: center; gap: 0.25rem; padding: 0.75rem 0.25rem; border-right: 1px solid var(--rule); border-bottom: 1px solid var(--rule); }
  .glyph { font-size: 2.5rem; line-height: 1.2; }

  /* The playground's features stack: each sets its own property, and this lists them all. */
  .ot-play {
    font-size: clamp(3rem, 9vw, 7rem);
    line-height: 1.1;
    overflow-wrap: anywhere;
    font-feature-settings:
      var(--ot-ss01, "ss01" 0), var(--ot-ss02, "ss02" 0), var(--ot-ss03, "ss03" 0), var(--ot-ss04, "ss04" 0),
      var(--ot-ss05, "ss05" 0), var(--ot-ss06, "ss06" 0), var(--ot-ss07, "ss07" 0), var(--ot-ss08, "ss08" 0),
      var(--ot-ss09, "ss09" 0), var(--ot-ss10, "ss10" 0), var(--ot-ss11, "ss11" 0),
      var(--ot-cv01, "cv01" 0), var(--ot-cv02, "cv02" 0), var(--ot-cv03, "cv03" 0), var(--ot-cv04, "cv04" 0),

---
// Highlighted code with five sample languages. The titles and copy buttons live only on this page,
// not in the kit. A theme can set --code-sample-size to change the code size here.
import { Code } from 'astro:components';
import { Icon } from 'astro-icon/components';
import SiteLayout from '../layouts/SiteLayout.astro';
import PageTitle from '@agentic-design-kits/swiss-minimal/astro/PageTitle.astro';

const samples = [
  {
    heading: 'JavaScript',
    file: 'stations.js',
    lang: 'js',
    code: `// Find the stations playing right now
import { stations } from './data.js';

const MAX_RESULTS = 12;

export async function liveStations(genre = 'jazz') {
  const live = stations.filter((s) => s.online && s.genres.includes(genre));
  return live.slice(0, MAX_RESULTS).map(({ name, city }) => \`\${name}, \${city}\`);
}`,
  },
  {
    heading: 'Bash',
    file: 'deploy.sh',
    lang: 'bash',
    code: `#!/usr/bin/env bash
# Build the site and stop at the first error
set -euo pipefail

SITE_DIR="demo"
cd "$SITE_DIR"

if [[ -f .nvmrc ]]; then
  nvm use
fi

npm ci && npm run build
echo "Built $(find dist -type f | wc -l) files"`,
  },
  {
    heading: 'Python',
    file: 'tracks.py',
    lang: 'python',
    code: `"""Count how often each composer was played."""
from collections import Counter
from dataclasses import dataclass


@dataclass
class Track:
    title: str
    composer: str | None = None
    seconds: int = 0


def top_composers(tracks: list[Track], limit: int = 5) -> list[tuple[str, int]]:
    # Tracks with no composer are left out
    counts = Counter(t.composer for t in tracks if t.composer)
    return counts.most_common(limit)`,
  },
  {
    heading: 'Java',
    file: 'Playlist.java',
    lang: 'java',
    code: `package com.example.radio;

import java.util.List;

/** A list of tracks with a total running time. */
public record Playlist(String name, List<Track> tracks) {
    private static final int SECONDS_PER_MINUTE = 60;

    public int totalMinutes() {
        int seconds = tracks.stream().mapToInt(Track::seconds).sum();
        return seconds / SECONDS_PER_MINUTE;
    }

    @Override
    public String toString() {
        return "%s (%d min)".formatted(name, totalMinutes());
    }
}`,
  },
  {
    heading: 'C#',
    file: 'NowPlaying.cs',
    lang: 'csharp',
    code: `using System.Net.Http.Json;

namespace Radio;

// Reads the current title for a station
public class NowPlaying(HttpClient http)
{
    private const int TimeoutSeconds = 5;

    public async Task<string?> GetTitleAsync(string stationId)
    {
        using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(TimeoutSeconds));
        var reply = await http.GetFromJsonAsync<Reply>($"/api/now-playing?station={stationId}", cts.Token);
        return reply?.Title;
    }

    private record Reply(string? Title);
}`,
  },
];
---

<SiteLayout title="Beautiful Code" description="Highlighted code in the kit's colors, with sample languages.">
  <PageTitle title="Beautiful Code" />
  <div class="max-w-4xl pb-16">
    <p class="mb-10">Any language Shiki supports takes the kit's code colors, so these five are only examples.</p>
    {
      samples.map(({ heading, file, lang, code }) => (
        <section class="mb-10">
          <h2 class="mb-3">{heading}</h2>
          <figure class="code-sample">
            <figcaption class="code-sample-bar">
              <span class="code-sample-file">{file}</span>
              <button type="button" class="code-sample-copy" aria-label={`Copy ${file}`}>
                <Icon name="material-symbols:content-copy-outline" class="icon" aria-hidden="true" />
                <span data-copy-label>Copy</span>
              </button>
            </figcaption>
            <Code code={code} lang={lang as any} theme="css-variables" />
          </figure>
        </section>
      ))
    }
    <p class="sr-only" role="status" data-copy-status></p>
  </div>
</SiteLayout>

<style is:global>
  .code-sample { margin: 0; }
  .code-sample-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0 0.25rem 0 0.75rem;
    border: 1px solid var(--rule);
    border-bottom: 0;
  }
  .code-sample-file { font-family: var(--font-mono); font-size: var(--size-100); overflow-wrap: anywhere; }
  .code-sample-copy {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.375rem;
    min-width: 6.5rem;
    min-height: 2.75rem;
    padding: 0 0.75rem;
    border: 0;
    background: transparent;
    color: inherit;
    font-size: var(--size-100);
    font-weight: var(--weight-strong);
  }
  .code-sample-copy:hover { text-decoration: underline; }
  .code-sample pre { tab-size: 4; padding: 0.75rem; font-size: var(--code-sample-size, var(--size-300)); font-weight: 400; }
</style>

<script>
  const status = document.querySelector<HTMLElement>('[data-copy-status]');
  for (const button of document.querySelectorAll<HTMLButtonElement>('.code-sample-copy')) {
    const label = button.querySelector<HTMLElement>('[data-copy-label]');
    let timer: number | undefined;
    button.addEventListener('click', async () => {
      const code = button.closest('.code-sample')?.querySelector('pre')?.textContent ?? '';
      try {
        await navigator.clipboard.writeText(code);
        if (label) label.textContent = 'Copied';
        if (status) status.textContent = 'Copied to the clipboard';
      } catch {
        if (label) label.textContent = 'Failed';
        if (status) status.textContent = 'Could not copy';
      }
      clearTimeout(timer);
      timer = window.setTimeout(() => {
        if (label) label.textContent = 'Copy';
        if (status) status.textContent = '';
      }, 2000);
    });
  }
</script>

---
import SiteLayout from '../layouts/SiteLayout.astro';
import Row from '../components/Row.astro';
import Section from '../components/Section.astro';
import Hero from '../design/kit/astro/Hero.astro';
import Cta from '../design/kit/astro/Cta.astro';
import CardGrid from '../design/kit/astro/CardGrid.astro';
import { getIndex, href } from '../data/blog';
import hero from '../assets/hero.jpg';

const principles = [
  { title: 'One typeface', meta: 'Weights 400, 500 and 700 only' },
  { title: 'Flat color', meta: 'Cream, ink and one vermilion' },
  { title: 'Thick rules', meta: 'A 2px line opens every section' },
  { title: 'The grid', meta: 'Header and rows share one set of columns' },
  { title: 'Quiet motion', meta: 'Short, eased, and off with Reduce Motion' },
  { title: 'Access first', meta: 'Visible focus, 14px floor, real buttons' },
];
const active = 2;

// The newest posts: the featured one over four cards, each cut to its summary's first sentence.
const firstSentence = (text: string) => text.split(/(?<=\.)\s/)[0];
const { featured, rest } = await getIndex();
const cards = rest.slice(0, 4).map((post) => ({
  title: post.data.title,
  href: href(post),
  summary: firstSentence(post.data.summary),
  tags: post.data.tags,
}));
---

<SiteLayout title="Home" description="A demo site for the Swiss Minimal design kit.">
  <Hero
    lead="A small test bed for the design kit: flat color, thick rules, one grotesque typeface."
    image={hero}
    alt="Abstract composition of black, grey and red circles and rectangles divided by black rules"
    caption="Composition in black, grey and red. Example artwork."
  >
    <Fragment slot="title">Swiss<br />Minimal</Fragment>
  </Hero>

  <Section id="principles" title="Principles" range="01–06">
    {
      principles.map((p, i) => (
        <Row num={i + 1} title={p.title} meta={p.meta} active={i + 1 === active}>
          {i + 1 === active && (
            <span class="eq" aria-hidden="true"><i></i><i></i><i></i></span>
          )}
        </Row>
      ))
    }
  </Section>

  <section class="mb-16 border-t-2 border-ink pt-3" aria-labelledby="reading">
    <h2 class="h2 pb-6" id="reading">Reading</h2>
    {
      featured && (
        <Cta
          class="mb-10"
          title={featured.data.title}
          text={firstSentence(featured.data.summary)}
          href={href(featured)}
          action="Read post"
        />
      )
    }
    <CardGrid cards={cards} columns={2} />
  </section>
</SiteLayout>

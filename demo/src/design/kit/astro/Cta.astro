---
// One thing to go and look at, with the page's primary button (CTA in COMPONENTS.md). Sits inside
// a section, opened by a thin rule: a small label, a title, a line or two of text, the button.
interface Props {
  title: string;
  text: string;
  href: string;
  /** The small label over the title. One or two words. */
  label?: string;
  /** The button's text. One or two words. */
  action?: string;
  /** Heading level for the title: h2 on its own, h3 inside a section. */
  level?: 'h2' | 'h3';
  /** Utilities for spacing, e.g. "mb-8". */
  class?: string;
}
const { title, text, href, label = 'Featured', action = 'View', level: Title = 'h3', class: className } = Astro.props;
---

<div class:list={['cta', className]}>
  <p class="label muted cta-label">{label}</p>
  <Title class="cta-title">{title}</Title>
  <p class="cta-text">{text}</p>
  <a class="btn" href={href} aria-label={`${action}: ${title}`}>{action}</a>
</div>
